{
  "manifest_version": 3,
  "name": "Visual Review for GitHub",
  "description": "Adds Visual Review links to GitHub PRs that contain image files",
  "version": "1.0.0",
  "permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["image_config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
