{
  "manifest_version": 3,
  "name": "Visual Review for GitHub",
  "description": "Adds Visual Review links, and an LGTM button for its reviewers, to GitHub PRs",
  "version": "1.1.0",
  "permissions": [],
  "host_permissions": [
    "https://vr.apw.photos/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "image_config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
