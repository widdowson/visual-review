load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_bazel_lib//lib:jq.bzl", "jq")
load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@bazel_skylib//rules:build_test.bzl", "build_test")

# Generate image_config.js from the shared image_extensions.json.
# Uses the hermetic jq toolchain — no host python3 dependency.
jq(
    name = "image_config",
    srcs = ["//:image_extensions.json"],
    out = "image_config.js",
    args = ["--raw-output"],
    filter = '"var IMAGE_EXTENSIONS = " + (keys_unsorted | tojson) + ";"',
)

js_library(
    name = "content_js",
    srcs = ["content.js"],
)

js_library(
    name = "background_js",
    srcs = ["background.js"],
)

# The full Chrome extension bundle: manifest + scripts + icons
filegroup(
    name = "extension",
    srcs = [
        "manifest.json",
        ":image_config",
        ":content_js",
        ":background_js",
    ] + glob(["icons/*.png"]),
    visibility = ["//visibility:public"],
)

# Materializes a directory Chrome can "Load unpacked" directly:
# bazel-bin/extension/extension_bundle/
copy_to_directory(
    name = "extension_bundle",
    srcs = [
        "manifest.json",
        "content.js",
        "background.js",
        ":image_config",
    ] + glob(["icons/*.png"]),
    visibility = ["//visibility:public"],
)

build_test(
    name = "extension_build_test",
    targets = [
        ":extension",
        ":extension_bundle",
    ],
)

# ── Tests ────────────────────────────────────────────────────────────────────

js_test(
    name = "test_manifest",
    entry_point = "test_manifest.js",
    data = [
        "manifest.json",
        "content.js",
        "background.js",
        ":image_config",
    ] + glob(["icons/*.png"]),
)

js_test(
    name = "test_icons",
    entry_point = "test_icons.js",
    data = [
        "manifest.json",
    ] + glob(["icons/*.png"]),
)

js_test(
    name = "test_content_logic",
    entry_point = "test_content_logic.js",
    data = [
        ":image_config",
        "//:image_extensions_json",
    ],
)
