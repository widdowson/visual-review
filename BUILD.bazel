# The repo page's logic is a module rather than a region of its HTML, so this
# requires it directly. static/repo.js is the entry point's own dependency —
# without it in data an edit to the page's logic changes no input of this
# target and the test takes a cache hit against the change.
js_test(
    name = "test_repo_page",
    entry_point = "tests/test_repo_page.js",
    # repo.html as well as repo.js: the harness runs the page's inline script
    # and the wiring check reads it as text, and an undeclared input is not in
    # the sandbox *and* is not a cache key — so such a check fails here and,
    # once passing, takes a cache hit on the very edit it exists to catch.
    data = [
        "static/repo.html",
        "static/repo.js",
        "tests/repo_page_harness.js",
    ],
)

# ── OCI container image ─────────────────────────────────────────────────────

# py_image_layer splits the py_binary's runfiles into optimized tar layers:
# - pip packages (changes rarely → cached)
# - app code (changes often → small layer)
oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    cmd = ["/server"],
    env = {"PORT": "8080"},
    tars = py_image_layer(
        name = "server_layers",
        binary = ":server",
        root = "/",
    ),
)

oci_push(
    name = "push",
    image = ":image",
    repository = "us-central1-docker.pkg.dev/vr-apw-photos/visual-review/app",
)
