# Browser-driven tests for the SPA (#21). Everything the page does with state —
# adopting an in-flight prefetch, aborting an abandoned load, the hashchange
# re-entry guard — needs a DOM, so it cannot be reached by the extraction tests
# below. This target drives the real page in hermetic Chromium against a fake
# backend whose request log is what the assertions read.
#
# static/index.html is the code under test, so it is in data for the same
# reason it is below: without it an index.html-only edit changes no input and
# the target takes a cache hit instead of running.
py_test(
    name = "test_spa_prefetch",
    # "medium" despite an ~9s happy path, which earns Bazel's "size is too big"
    # advisory: a total-prefetch-failure mutant spends ~83s in wait_until
    # timeouts before reporting, against medium's 300s cap, and a browser is
    # not a small-size workload. That number moves with every wait added — it
    # was 66s until this file's own adoption test added a 15s gate — so read
    # the headroom rather than the figure.
    size = "medium",
    srcs = [
        "tests/__init__.py",
        "tests/fixture_server.py",
        "tests/run_tests.py",
        "tests/spa_harness.py",
        "tests/test_spa_prefetch.py",
    ],
    args = ["tests/test_spa_prefetch.py"],
    data = [
        "browsers.1.57.0.json",
        "static/index.html",
        "@playwright//:chromium-headless-shell",
    ],
    env = {
        "BAZEL_PLAYWRIGHT_CHROMIUM": "$(rlocationpath @playwright//:chromium-headless-shell)",
    },
    main = "tests/run_tests.py",
    tags = ["browser"],
    deps = [
        # The fixture asks app.py for the image Cache-Control rather than
        # copying the literal, so that "the immutable header is load-bearing"
        # cannot go on being asserted about a header production stopped
        # sending.
        ":app_lib",
        requirement("playwright"),
        requirement("pytest"),
    ],
)

# The SPA's logic lives inline in static/index.html; these tests extract the
# marked regions from that file rather than keeping a copy, so they cannot
# pass against logic that has since changed. static/index.html is therefore a
# real input — without it in data the test would take a cache hit after an
# index.html-only edit and never run against the change.
js_test(
    name = "test_prefetch_policy",
    entry_point = "tests/test_prefetch_policy.js",
    data = [
        "static/index.html",
        "tests/spa_source.js",
    ],
)

