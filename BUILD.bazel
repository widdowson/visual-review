# ── Python tests (pytest) ───────────────────────────────────────────────────

py_test(
    name = "test_app",
    srcs = [
        "tests/run_tests.py",
        "tests/test_app.py",
        "tests/__init__.py",
    ],
    args = ["tests/test_app.py"],
    data = ["image_extensions.json"],
    # These tests predate the Cloudflare Access gate and assert on responses,
    # not on authentication. Without this every one of them would get a 403 and
    # the suite would say the app was broken rather than that it was guarded.
    # //:test_auth is where the gate itself is exercised, armed.
    env = {"VR_AUTH_MODE": "disabled"},
    main = "tests/run_tests.py",
    deps = [
        ":app_lib",
        requirement("httpx"),
        requirement("pytest"),
        requirement("pytest-asyncio"),
    ],
)

py_test(
    name = "test_auth",
    srcs = [
        "tests/__init__.py",
        "tests/run_tests.py",
        "tests/test_auth.py",
    ],
    args = ["tests/test_auth.py"],
    data = [
        "image_extensions.json",
        "static/favicon.svg",
        "static/index.html",
    ],
    # Imports app.py, whose module-level auth config is read at import time.
    # The gate is then armed per test by swapping the verifier, so the module
    # still has to import under a configuration that does not raise.
    env = {"VR_AUTH_MODE": "disabled"},
    main = "tests/run_tests.py",
    deps = [
        ":app_lib",
        requirement("cryptography"),
        requirement("httpx"),
        requirement("pyjwt"),
        requirement("pytest"),
        requirement("pytest-asyncio"),
    ],
)

# Browser-driven tests for the SPA (#21). Everything the page does with state —
# adopting an in-flight prefetch, aborting an abandoned load, the hashchange
# re-entry guard — needs a DOM, so it cannot be reached by the extraction tests
# below. This target drives the real page in hermetic Chromium against a fake
# backend whose request log is what the assertions read.
#
# static/index.html is the code under test, so it is in data for the same
# reason it is below: without it an index.html-only edit changes no input and
# the target takes a cache hit instead of running.
py_test(
    name = "test_spa_prefetch",
    # "medium" despite an ~8s happy path, which earns Bazel's "size is too big"
    # advisory: a total-prefetch-failure mutant spends 66s in wait_until
    # timeouts before reporting, and a browser is not a small-size workload.
    size = "medium",
    srcs = [
        "tests/__init__.py",
        "tests/fixture_server.py",
        "tests/run_tests.py",
        "tests/spa_harness.py",
        "tests/test_spa_prefetch.py",
    ],
    args = ["tests/test_spa_prefetch.py"],
    data = [
        "browsers.1.57.0.json",
        "static/index.html",
        "@playwright//:chromium-headless-shell",
    ],
    env = {
        "BAZEL_PLAYWRIGHT_CHROMIUM": "$(rlocationpath @playwright//:chromium-headless-shell)",
        # The fixture server imports app.py, whose Access config is read at
        # import. Without this the module raises and the whole file fails to
        # collect.
        "VR_AUTH_MODE": "disabled",
    },
    main = "tests/run_tests.py",
    tags = ["browser"],
    deps = [
        # The fixture asks app.py for the image Cache-Control rather than
        # copying the literal, so that "the immutable header is load-bearing"
        # cannot go on being asserted about a header production stopped
        # sending.
        ":app_lib",
        requirement("playwright"),
        requirement("pytest"),
    ],
)

# The deploy workflow is the only place the app's production environment is
# written down, and `bazel test` does not otherwise read .github/. Both defects
# it guards against surface only on a merge to main.
py_test(
    name = "test_deploy_workflow",
    srcs = [
        "tests/__init__.py",
        "tests/run_tests.py",
        "tests/spa_harness.py",
        "tests/test_deploy_workflow.py",
    ],
    args = ["tests/test_deploy_workflow.py"],
    data = [
        ".github/workflows/deploy.yml",
        "auth.py",
        "static/index.html",
    ],
    env = {"VR_AUTH_MODE": "disabled"},
    main = "tests/run_tests.py",
    deps = [
        ":app_lib",
        requirement("pytest"),
        requirement("pyyaml"),
    ],
)

