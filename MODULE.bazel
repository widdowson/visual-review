module(
    name = "visual-review",
    version = "0.0.0",
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "aspect_rules_js", version = "3.0.3")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "aspect_rules_py", version = "1.9.1")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_playwright", version = "0.5.3")

# ── Python toolchain ─────────────────────────────────────────────────────────

# ── Pip dependencies ─────────────────────────────────────────────────────────
# Uses the Python 3.11 host toolchain registered by aspect_rules_js.
# The OCI container image independently uses python:3.12-slim as its base.

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.11",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pip")

# ── OCI base image ───────────────────────────────────────────────────────────

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "python_slim",
    image = "docker.io/library/python",
    tag = "3.12-slim",
    platforms = ["linux/amd64"],
)
use_repo(oci, "python_slim", "python_slim_linux_amd64")

# ── Playwright browser binaries ──────────────────────────────────────────────
# Hermetic Chromium for the browser-driven SPA tests (#21). browsers.json must
# match the playwright pip package version in requirements_lock.txt.
#
# Pinned to the 1.57.0 browsers because Playwright 1.58 changed the CDN URL
# format (microsoft/playwright#38573) and rules_playwright 0.5.3 still builds
# the old paths, which now 404 (mrmeku/rules_playwright#36).
#
# browsers.1.57.0.json is trimmed to the single browser this repo runs. The
# extension declares one http_file per browser per platform, so upstream's
# full manifest makes @playwright//... expand to 244 targets and about 7 GB
# of mac and arm64 archives nothing here will ever launch; trimmed it is 25.
# Removing the entries beats documenting them, since a comment saying "do not
# fetch that" only works on someone who reads it first.
#
# Which Linux build is fetched is @rules_playwright//:linux_distro, a build
# flag defaulting to ubuntu24.04 — it does not detect the host. See README.md;
# CI pins its runner to match.
playwright = use_extension("@rules_playwright//playwright:extensions.bzl", "playwright")
playwright.repo(
    name = "playwright",
    browsers_json = "//:browsers.1.57.0.json",
)
use_repo(playwright, "playwright")
